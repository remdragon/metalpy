'''
Shared route-handling logic for the two demo entry points
(http_server_demo_sync.mpy - thread-per-connection blocking I/O,
http_server_demo_async.mpy - reactor-driven async I/O). Both import App
from here and drive it over their own choice of accept loop - the routes
themselves don't know or care which concurrency model is running them.
'''

import compiler
import io
import os
import asyncfile
from datetime import datetime
from fs import SEEK_SET, SEEK_END
from http.server import Request, Response

_STATIC_BASE: str = 'demo/www'

def _read_static_file( file_path: str ) -> Result[bytes, OSError|ValueError]:
	reader: BinaryReader = asyncfile.AsyncFile.binary_reader( file_path ).or_return()
	size: i64 = reader.seek( i64( 0 ), SEEK_END ).or_return()
	if size < 0:
		return Result.Err( ValueError() )
	reader.seek( i64( 0 ), SEEK_SET ).or_return()
	with compiler.panic_arithmetic( 'a real static file fits well within usize' ):
		n: usize = usize( size )
	buf: bytearray = bytearray( n )
	io.read_exact( reader, buf.get_ptr(), n ).or_return()
	return Result.Ok( bytes.from_bytearray( move( buf )))

def _serve_static( path: str ) -> Response:
	''' resolves path against the www/ subfolder next to this file (i.e.
	demo/www, assuming the program runs from the repo root) and serves it
	via async file I/O - the point being to exercise that path under the
	reactor too, not just sockets. Rejects any request whose normalized
	path escapes demo/www, via os.path.is_relative_to (provably correct,
	not a hand-rolled '..'-segment scan). '''
	file_path: str = os.path.join( _STATIC_BASE, path )
	if not os.path.is_relative_to( os.path.normpath( file_path ), os.path.normpath( _STATIC_BASE )):
		return Response.text( 'Forbidden\n', 403, 'Forbidden' )
	match _read_static_file( file_path ):
		case Result.Ok( content ):
			return Response.bytes_( content, 'text/html; charset=utf-8', 200, 'OK' )
		case Result.Err( _ ):
			# TODO FIXME: error logging?
			return Response.text( 'Not Found\n', 404, 'Not Found' )

class App:
	def handle( self, req: Request ) -> Response:
		match req.path:
			case '/':
				now = datetime.now().strftime( '%Y-%m-%d %H:%M:%S%z %Z' )
				return Response.text( f'hello from MetalPy http demo server @ {now}' )
			case '/echo':
				return Response.text( 'you asked for ' + req.path )
			case _:
				return _serve_static( req.path )
