'''
Synchronous demo server - thread-per-connection blocking I/O, NO reactor
anywhere. Every accepted connection gets its own real OS thread, and that
thread's read()/write() calls genuinely block the OS (tcp.py's own
reactor-optional TcpConnection falls back to a real blocking wait when no
Reactor is driving the current thread - see reactor.wait_for_signal's own
docstring). This is the classic thread-per-connection model, useful as a
stress-test BASELINE to compare against demo/http_server_demo_sync.mpy's
new bounded-ThreadPool default (and http_server_demo_async.mpy's
reactor-driven concurrency) - not a "lightweight" version of either, a
real OS thread per connection is comparatively expensive.

Built on the same lib/tcpserver.py + http.server.serve_sync() as the
bounded-pool demo, just with an explicit
tcpserver.ThreadPerConnectionDispatcher() instead of the library default.
'''

import tcp
import socket
import tcpserver
from http.server import serve_sync
from demo.http_server_demo_app import App


def main() -> i32:
	listener: tcp.TcpListener = tcp.TcpListener.bind( '0.0.0.0', u16( 8080 )).unwrap( lambda e: f'error binding 0.0.0.0:8080: {e}' )
	addr: socket.SocketAddr = listener.getsockname().unwrap( 'error getting address from socket' )
	print( f'listening on http://0.0.0.0:{addr.port} (sync, thread-per-connection)' )
	app: App = App()
	dispatcher: tcpserver.ConnectionDispatcher = tcpserver.ThreadPerConnectionDispatcher()
	serve_sync( listener, app.handle, dispatcher ).run()
	return 0
